{
  "name": "@fadhelhaidar/pi-ask-user",
  "version": "1.0.1",
  "description": "Standalone Pi questionnaire with combined multi-select and custom answers, Enter-only toggling, and preserved drafts.",
  "type": "module",
  "license": "MIT",
  "author": "FadhelHaidar",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FadhelHaidar/pi-ask-user.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    }
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:check": "bun scripts/build.ts --check",
    "test": "vitest run",
    "typecheck": "tsc -p tests/types/tsconfig.json"
  },
  "files": [
    "dist/",
    "LICENSE",
    "docs/",
    "!docs/*.png",
    "!docs/*.jpg",
    "!docs/*.svg",
    "README.md",
    "NOTICE.md",
    "!**/*.test.ts"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*",
    "@juicesharp/rpiv-i18n": "*"
  },
  "peerDependenciesMeta": {
    "@juicesharp/rpiv-i18n": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "@juicesharp/rpiv-i18n": "2.12.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
